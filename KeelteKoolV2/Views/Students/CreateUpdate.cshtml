@model KeelteKoolV2.Models.Students.StudentCreateUpdateViewModel

<h1>@(Model.Id.HasValue ? "Muuda õpilast" : "Lisa õpilane")</h1>

<form method="post" asp-controller="Students" asp-action="@(Model.Id.HasValue ? "Update" : "Create")">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="UserID" type="hidden" />

    <div class="form-group">
        <label asp-for="FirstName" class="control-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName" class="control-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Salvesta</button>
    <a asp-action="Index" class="btn btn-secondary">Tagasi</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
