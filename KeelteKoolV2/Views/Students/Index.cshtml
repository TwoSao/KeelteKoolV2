@model IEnumerable<KeelteKoolV2.Models.Students.StudentViewModel>
@{
    ViewBag.Title = "Õpilased";
}

<h1>Õpilased</h1>
<p>
    <a asp-action="Create" asp-controller="Students" class="btn btn-dark">Lisa õpilane</a>
</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Eesnimi</th>
            <th scope="col">Perekonnanimi</th>
            <th scope="col">Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @{ var rowNumber = 1; }
        @foreach (var student in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-secondary">Andmed</a>
                    <a asp-action="Update" asp-route-id="@student.Id" class="btn btn-warning">Muuda</a>
                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-danger">Kustuta</a>
                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>
